EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
EXPO_PUBLIC_OIDC_ISSUER_URL=https://your-tenant.example.com/
EXPO_PUBLIC_OIDC_CLIENT_ID=your_native_client_id
EXPO_PUBLIC_OIDC_AUDIENCE=ai-reader-api
# Optional - leave unset for local dev. Sentry.init() disables itself entirely when
# this is empty, so there's nothing to configure until you actually have a DSN.
EXPO_PUBLIC_SENTRY_DSN=
