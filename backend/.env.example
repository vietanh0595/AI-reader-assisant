OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal
CORS_ALLOW_ORIGINS=*
DATABASE_URL=postgresql+psycopg://reader:reader@localhost:5432/reader
OIDC_ISSUER_URL=https://your-tenant.example.com/
OIDC_AUDIENCE=ai-reader-api
OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RAG_VECTOR_CANDIDATES=30
RAG_KEYWORD_CANDIDATES=30
RAG_FUSED_CANDIDATES=8
RAG_RRF_K=60
RAG_MIN_VECTOR_SIMILARITY=0.35
RAG_CONTEXT_MAX_CHARS=18000
# Shared by both the web service and the worker's own DB engine. Defaults to 3/2 if
# unset - raise directly in Render's dashboard (no redeploy needed) once real
# multi-user traffic needs more than that.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Optional - leave unset for local dev. Both the web service and the worker skip
# sentry_sdk.init() entirely when this is empty, so there's nothing to configure
# until you actually have a DSN. Same DSN works for both (they're separate Render
# services, but one Sentry project can receive events from both processes).
SENTRY_DSN=
